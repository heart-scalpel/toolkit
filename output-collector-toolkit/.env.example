# Copy to .env. Everyone registers with their own email and password in the browser.
# Internal server address. Use http://localhost:3722 for local development.
COLLECTOR_PUBLIC_ORIGIN=http://172.17.23.51:3722
# Must match the scheme: false for HTTP, true for HTTPS. Auto-detected if omitted.
COLLECTOR_COOKIE_SECURE=false
COLLECTOR_SESSION_HOURS=168

# Pass --env-file .env to Compose so port/build substitutions use this file too.
BIND_HOST=0.0.0.0
PORT=3722
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
