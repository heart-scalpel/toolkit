{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewOutput v4.0.0",
  "type": "object",
  "properties": {
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "safety": {
            "type": "object",
            "properties": {
              "candidate_class": {
                "enum": [
                  "non_health",
                  "general_health",
                  "personalized_health",
                  "general_medical",
                  "restricted_medical",
                  null
                ]
              },
              "boundary_note": {
                "type": "string"
              }
            },
            "required": [
              "candidate_class",
              "boundary_note"
            ],
            "additionalProperties": false
          },
          "initial_assessment": {
            "type": "string",
            "minLength": 1
          },
          "possible_consultation_response": {
            "type": "string",
            "minLength": 1
          },
          "follow_ups": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "question",
                "purpose"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "case_id",
          "safety",
          "initial_assessment",
          "possible_consultation_response",
          "follow_ups"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "reviews"
  ],
  "additionalProperties": false
}
