# Instance: health requires only this URL.
LANGFUSE_BASE_URL=http://localhost:3000

# Project: run "project info", then copy its ID below.
LANGFUSE_PROJECT_PUBLIC_KEY=
LANGFUSE_PROJECT_SECRET_KEY=
LANGFUSE_PROJECT_ID=
# Legacy LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY remain project-only aliases.

# Organization: optional, used only by "org projects list".
LANGFUSE_ORG_PUBLIC_KEY=
LANGFUSE_ORG_SECRET_KEY=

# Session: optional, only for actual "project playground run".
# Paste the Cookie header value, including session-token names/chunks.
LANGFUSE_SESSION_COOKIE=
